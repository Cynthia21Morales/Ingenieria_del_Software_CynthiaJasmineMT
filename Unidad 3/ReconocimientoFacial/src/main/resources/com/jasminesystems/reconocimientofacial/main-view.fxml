<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="733.0" prefWidth="778.0" style="-fx-background-color:#0f172a;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jasminesystems.reconocimientofacial.controller.MainController">

    <!-- HEADER CON LOGOS -->
    <top>

        <VBox alignment="CENTER" spacing="15" style="-fx-background-color:#020617;">

            <padding>
                <Insets bottom="15" top="15" />
            </padding>

            <HBox alignment="CENTER" spacing="60">

                <!-- LOGO INSTITUCION 1 -->
                <ImageView fitHeight="70" preserveRatio="true">
                    <image>
                        <Image url="@/images/logo1.png" />
                    </image>
                </ImageView>

                <!-- LOGO SISTEMA -->
                <ImageView fitHeight="80" preserveRatio="true">
                    <image>
                        <Image url="@/images/logo_sistema.png" />
                    </image>
                </ImageView>

                <!-- LOGO INSTITUCION 2 -->
                <ImageView fitHeight="70" preserveRatio="true">
                    <image>
                        <Image url="@/images/logo2.png" />
                    </image>
                </ImageView>

            </HBox>

            <Label style="-fx-font-size:30px;                           -fx-text-fill:white;                           -fx-font-weight:bold;                           -fx-font-family:'Segoe UI';" text="SISTEMA BIOMÉTRICO DE ASISTENCIA" />

            <HBox alignment="CENTER" spacing="40">

                <Label style="-fx-text-fill:#94a3b8; -fx-font-size:18px;" text="Fecha:" />

                <Label fx:id="fechaLabel" style="-fx-text-fill:#22c55e; -fx-font-size:20px; -fx-font-weight:bold;" />

                <Label style="-fx-text-fill:#94a3b8; -fx-font-size:18px;" text="Hora:" />

                <Label fx:id="horaLabel" style="-fx-text-fill:#22c55e; -fx-font-size:20px; -fx-font-weight:bold;" />

            </HBox>

        </VBox>

    </top>

    <!-- CAMARA -->
    <center>

        <VBox alignment="CENTER" prefHeight="303.0" prefWidth="439.0" spacing="20">

            <ImageView fx:id="cameraView" fitHeight="326.0" fitWidth="395.0" preserveRatio="true" style="-fx-background-color:black;                               -fx-border-color:#334155;                               -fx-border-width:3;                               -fx-border-radius:10;                               -fx-background-radius:10;" />

        </VBox>

    </center>

    <!-- CONTROLES -->
    <bottom>

        <VBox alignment="CENTER" spacing="18">

            <padding>
                <Insets bottom="30" top="20" />
            </padding>

            <TextField fx:id="txtIdDocente" promptText="Ingrese ID del docente" style="-fx-font-size:15px;                               -fx-background-radius:8;                               -fx-pref-width:260;                               -fx-padding:10;" />

            <HBox alignment="CENTER" spacing="25">

                <Button onAction="#iniciarCamara" style="-fx-background-color:#22c55e;                                -fx-text-fill:white;                                -fx-font-size:15px;                                -fx-background-radius:8;                                -fx-padding:10 25;" text="Iniciar Cámara" />

                <Button onAction="#registrarRostro" style="-fx-background-color:#3b82f6;                                -fx-text-fill:white;                                -fx-font-size:15px;                                -fx-background-radius:8;                                -fx-padding:10 25;" text="Registrar Rostro" />

                <Button onAction="#tomarAsistencia" style="-fx-background-color:#6366f1;                                -fx-text-fill:white;                                -fx-font-size:15px;                                -fx-background-radius:8;                                -fx-padding:10 25;" text="Tomar Asistencia" />

                <Button onAction="#detenerCamara" style="-fx-background-color:#ef4444;                                -fx-text-fill:white;                                -fx-font-size:15px;                                -fx-background-radius:8;                                -fx-padding:10 25;" text="Apagar Cámara" />

            </HBox>

            <Label fx:id="statusLabel" style="-fx-text-fill:#cbd5f5;                           -fx-font-size:16px;" text="Estado del sistema" />

        </VBox>

    </bottom>

</BorderPane>
